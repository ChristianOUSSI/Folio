# Portfolio principal (https://portfolio0-kappa.vercel.app)
# URLs des projets déployés individuellement sur Vercel.
# À configurer dans les variables d'environnement Vercel après déploiement de chaque projet.

NEXT_PUBLIC_MOBILE_HUB_URL=https://votre-mobile-hub.vercel.app
NEXT_PUBLIC_SAAS_ADMIN_URL=https://votre-saas-admin.vercel.app
NEXT_PUBLIC_BLADE_QUEST_URL=https://votre-blade-quest.vercel.app
NEXT_PUBLIC_DATADASH_URL=https://votre-datadash.vercel.app

# ========================
# Contact Form - Resend API
# ========================
# Obtenez votre clé API sur https://resend.com
RESEND_API_KEY=re_123456789

# Optionnel: Email de destination (défaut: Christian.oussi01@gmail.com)
# CONTACT_TO_EMAIL=votre-email@exemple.com

# Optionnel: Email d'expéditeur (défaut: Portfolio Contact <onboarding@resend.dev>)
# Note: Avec le plan gratuit de Resend, vous devez utiliser onboarding@resend.dev
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ========================
# Security - CSRF Protection
# ========================
# Changez cette valeur en production avec quelque chose de sécurisé
CSRF_SECRET=your_secret_key_change_in_production

# ========================
# Monitoring & Analytics (Optionnel)
# ========================
# Sentry Error Tracking
# Obtenez votre DSN sur https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here


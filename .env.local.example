# ========================================
# CONFIGURATION LOCALE - Portfolio
# ========================================
# Copiez ce fichier vers .env.local et modifiez les valeurs

# ========================================
# EMAIL SERVICE (Resend)
# ========================================
# Obtenez votre clé API sur https://resend.com
RESEND_API_KEY=re_1234567890abcdef

# Email de destination pour les messages du formulaire
CONTACT_TO_EMAIL=Christian.oussi01@gmail.com

# ========================================
# SÉCURITÉ
# ========================================
# Générez une valeur sécurisée pour la production
# Commande PowerShell: [System.Web.Security.Membership]::GeneratePassword(32, 4)
CSRF_SECRET=ma_cle_secrete_tres_longue_et_complexe_12345

# ========================================
# URLS DES PROJETS DÉPLOYÉS
# ========================================
# Ces URLs seront générées après déploiement sur Vercel
# Laissez vides pour commencer, ajoutez-les après déploiement

NEXT_PUBLIC_MOBILE_HUB_URL=
NEXT_PUBLIC_SAAS_ADMIN_URL=
NEXT_PUBLIC_BLADE_QUEST_URL=
NEXT_PUBLIC_DATADASH_URL=

# ========================================
# MONITORING (OPTIONNEL)
# ========================================
# Sentry pour le monitoring d'erreurs
# Obtenez votre DSN sur https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ========================================
# INSTRUCTIONS
# ========================================
# 1. Modifiez RESEND_API_KEY avec votre vraie clé Resend
# 2. Changez CSRF_SECRET avec une valeur sécurisée
# 3. Après déploiement des projets individuels, ajoutez leurs URLs
# 4. Pour la production, utilisez des valeurs sécurisées